# SQAF — environment variables (Stage 1). Copy to `.env` to use locally.
# `.env` is optional and never versioned. Variables already set in the shell
# or in CI take precedence over this file. See ADR-0005.

# Target environment. Allowed values: production (default).
SQAF_ENV=production

# Optional override of the environment's base URL for the SQAF suites.
# Must be an origin (scheme + host [+ port]) without path, query or fragment.
# It NEVER applies to the experimental baseline, which always targets
# https://automationexercise.com (Stage 0 condition).
# SQAF_BASE_URL=https://automationexercise.com
