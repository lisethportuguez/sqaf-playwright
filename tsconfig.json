{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": false,
    "paths": {
      "@sqaf/*": ["./src/*"]
    }
  },
  "include": ["playwright.config.ts", "config/**/*.ts", "src/**/*.ts", "baseline/**/*.ts", "tests/**/*.ts"]
}
